{
  "name": "catalogo-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.20.2",
    "npm": "10.8.2"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,backend \"npm run dev:frontend\" \"npm --prefix ../backend run dev:backend\"",
    "dev:frontend": "vite --host",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "perf:lighthouse": "lhci autorun --config=./.lighthouserc.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.6.0",
    "@joint/core": "^4.3.4",
    "@tanstack/react-query": "^5.40.0",
    "@xyflow/react": "^13.0.2",
    "autoprefixer": "^10.4.0",
    "html2canvas": "^1.4.1",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.52.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.23.0",
    "tailwindcss": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
