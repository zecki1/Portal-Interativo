{
  "name": "catalogo-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.20.2",
    "npm": "10.8.2"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm run dev:backend\" \"npm --prefix ../frontend run dev:frontend\"",
    "dev:backend": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^6.1.0",
    "@napi-rs/canvas": "^1.2.0",
    "@prisma/client": "^5.14.0",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.10",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "pdf-to-png-converter": "^4.3.0",
    "pdfjs-dist": "^4.10.38",
    "redis": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "concurrently": "^10.0.7",
    "prisma": "^5.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
