    {
      "id": "0e7acd76-fb82-4e61-8665-1822697faf8c",
      "pageNumber": 2,
      "title": "Seção 2",
      "blocks": [
        {
          "id": "7723c9c0-2410-4779-9c00-c208e8a181e4",
          "type": "heading",
          "data": {
            "level": 2,
            "text": "É HORA DE BRINCAR DE ILHA DESERTA!"
          }
        },
        {
          "id": "648f3901-dcd1-4d3c-b0b6-10bcee509df7",
          "type": "heading",
          "data": {
            "level": 2,
            "text": "IMAGINE UMA VIAGEM PARA UMA ILHA DESERTA."
          }
        },
        {
          "id": "69810e98-20e8-49e9-958c-b88ef71ed89c",
          "type": "paragraph",
          "data": {
            "html": "MAS ATENÇÃO: CADA PESSOA SÓ PODE PARTICIPAR SE TROUXER UM OBJETO ADEQUADO PARA ENTRAR NA ILHA."
          }
        },
        {
          "id": "29f69d4a-7ab6-42e8-84db-380a87aa2c0f",
          "type": "paragraph",
          "data": {
            "html": "O PROFESSOR VAI INDICAR O PRIMEIRO OBJETO E VOCÊ DEVE IDENTIFICAR UM PADRÃO PARA CONSEGUIR ENTRAR NA ILHA TAMBÉM."
          }
        },
        {
          "id": "bd61f60a-d154-4b45-a102-fb99f9d44b9c",
          "type": "paragraph",
          "data": {
            "html": "DESENHE O OBJETO INDICADO PELO PROFESSOR E, EM SEGUIDA, OS OBJETOS QUE VOCÊ PENSOU. LEMBRE-SE QUE É PRECISO ESCOLHER UM PADRÃO."
          }
        },
        {
          "id": "68e63f62-f3ea-4723-ba95-0095c0ed4c8b",
          "type": "paragraph",
          "data": {
            "html": "DOS ELEMENTOS QUE APARECEM NA IMAGEM ANTERIOR: QUAIS PERTENCEM AO QUARTO DE UMA CRIANÇA?"
          }
        },
        {
          "id": "4f5fe854-7f6a-42d0-98e0-0297ce0b7100",
          "type": "paragraph",
          "data": {
            "html": "NO ESPAÇO A SEGUIR, FAÇA O DESENHO DE UM QUARTO ORGANIZADO COM OS ELEMENTOS QUE VOCÊ IDENTIFICOU."
          }
        },
        {
          "id": "5c115ba0-9844-4e74-a5dd-4164d5bc3267",
          "type": "paragraph",
          "data": {
            "html": "Programa SESI Educação Tecnológica"
          }
        },
        {
          "id": "b6a36e39-85ab-43ea-952a-0d70fd776478",
          "type": "heading",
          "data": {
            "level": 2,
            "text": "LEIA O TEXTO A SEGUIR:"
          }
        },
        {
          "id": "b1c479e9-ab73-47a6-a528-8d973a2531cd",
          "type": "paragraph",
          "data": {
            "html": "OBSERVE A IMAGEM COM ATENÇÃO E CIRCULE CINCO OBJETOS QUE GERALMENTE NÃO SÃO ENCONTRADOS NO QUARTO DE UMA CRIANÇA."
          }
        }
      ]
    },
    {
      "id": "4ff5e4ca-5195-4743-9121-95e752f5db4c",
      "pageNumber": 3,
      "title": "Seção 3",
      "blocks": [
        {
          "id": "524e9d6d-ec36-4d99-82b6-11ddb6039cf3",
          "type": "paragraph",
          "data": {
            "html": "b"
          }
        },
        {
          "id": "7e5bc45d-cd39-4a62-bb32-7e218214fbd3",
          "type": "heading",
          "data": {
            "level": 2,
            "text": "A"
          }
        },
        {
          "id": "37d64bb9-e40b-4a9a-a148-1c7478cf1e20",
          "type": "heading",
          "data": {
            "level": 2,
            "text": "DESENHE NOS ESPAÇOS A SEGUIR:"
          }
        },
        {
          "id": "ca3f0795-9d80-4853-a41d-7304ce78aff7",
          "type": "heading",
          "data": {
            "level": 2,
            "text": "A FORMA COMO SUA EQUIPE SEPAROU OS BLOCOS."
          }
        },
        {
          "id": "4f457de2-8da1-480e-b9c6-deaf79ae1879",
          "type": "heading",
          "data": {
            "level": 2,
            "text": "UMA FORMA DIFERENTE COMO OUTRA EQUIPE ORGANIZOU OS BLOCOS."
          }
        },
        {
          "id": "608ffd78-dfb2-4627-9608-577d39f1477c",
          "type": "paragraph",
          "data": {
            "html": "Colorfuel Studio/Adobe Stock"
          }
        },
        {
          "id": "e689ba79-5c0c-42df-befc-83dcc471d5e1",
          "type": "paragraph",
          "data": {
            "html": "Tatsiana/Adobe Stock"
          }
        },
        {
          "id": "32726896-a89e-4332-a683-b533bc94f37e",
          "type": "paragraph",
          "data": {
            "html": "Programa SESI Educação Tecnológica"
          }
        },
        {
          "id": "b0238b6a-2356-4df0-99af-865742611b4e",
          "type": "paragraph",
          "data": {
            "html": "Alexstudio/Adobe Stock"
          }
        },
        {
          "id": "d7846fee-5b09-45a9-9c4f-56833e4281b8",
          "type": "heading",
          "data": {
            "level": 2,
            "text": "PADRÃO É ALGUMA CARACTERÍSTICA QUE SE REPETE."
          }
        }
      ]
    },
    {
      "id": "5bd0a21a-102f-43e7-b178-0b99e6ffc144",
      "pageNumber": 4,
      "title": "Seção 4",
      "blocks": [
        {
          "id": "afcef058-6c5f-4411-9230-73448ee6e2a1",
          "type": "paragraph",
          "data": {
            "html": "PARA O COMPUTADOR RECONHECER UM PADRÃO, ELE PRECISA ENTENDER O ALGORITMO OU A PROGRAMAÇÃO."
          }
        },
        {
          "id": "569f350a-29e1-4d10-9427-5ef7400abf7c",
          "type": "paragraph",
          "data": {
            "html": "QUE TAL TENTAR CLASSIFICAR BLOCOS DE MONTAR A PARTIR DE UM PADRÃO? FORME UMA EQUIPE COM SEUS COLEGAS E JUNTOS, ESCOLHAM UMA CARACTERÍSTICA PARA AGRUPAR OS BLOCOS."
          }
        },
        {
          "id": "85922aaa-83a0-4ad7-bfaf-4dadaba46898",
          "type": "heading",
          "data": {
            "level": 2,
            "text": "QUE PADRÕES PODEMOS USAR PARA ARRUMAR OS BLOCOS?"
          }
        },
        {
          "id": "4f88b06f-a5db-4f48-8e5e-0af845e3848d",
          "type": "paragraph",
          "data": {
            "html": "Reconhecendo Padrões"
          }
        },
        {
          "id": "faaf439f-5e08-4d25-9322-d25b6eaf8c55",
          "type": "paragraph",
          "data": {
            "html": "Atividade fundamental 1"
          }
        },
        {
          "id": "f644f02a-b4b5-4a00-9b07-79936bf9d55c",
          "type": "paragraph",
          "data": {
            "html": "SÔNIA É A MÃE DE JOÃO. TODOS OS DIAS ELA ARRUMA A CASA COM MUITO CUIDADO."
          }
        },
        {
          "id": "b4e9f019-2388-411d-9e2d-2c087dc14865",
          "type": "paragraph",
          "data": {
            "html": "HOJE, AO ENTRAR NO QUARTO DO FILHO, ELA FICOU MUITO IRRITADA COM O QUE VIU."
          }
        },
        {
          "id": "2650a748-2937-43c5-90dc-b7b01cd6ad89",
          "type": "heading",
          "data": {
            "level": 2,
            "text": "O QUARTO ESTAVA TOTALMENTE DESORGANIZADO!"
          }
        },
        {
          "id": "39d484d3-c2ba-46b5-ba6f-782b0e34335f",
          "type": "heading",
          "data": {
            "level": 2,
            "text": "JOÃO LEVARIA DIAS PARA ARRUMAR TODA AQUELA BAGUNÇA."
          }
        }
      ]
    }
  ]
}